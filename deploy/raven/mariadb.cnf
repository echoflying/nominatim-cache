[client]
socket=/run/nominatim-cache-db/mariadb.sock

[mariadbd]
basedir=/mnt/datadisk0/nominatim-cache/vendor/mariadb-11.4.13
datadir=/mnt/datadisk0/nominatim-cache/mariadb
socket=/run/nominatim-cache-db/mariadb.sock
pid-file=/run/nominatim-cache-db/mariadbd.pid
skip-networking
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
innodb_buffer_pool_size=128M
max_connections=32
