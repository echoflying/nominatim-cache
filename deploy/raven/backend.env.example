APP_ENV=production
LISTEN_ADDR=127.0.0.1:18197
ADMIN_LISTEN_ADDR=127.0.0.1:18198
BASE_PATH=/nominatim
FRONTEND_DIR=/opt/nominatim-cache/current/frontend
MARIADB_DSN="nc_app:replace_with_password@unix(/run/nominatim-cache-db/mariadb.sock)/nominatim_cache"
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32; keep this stable and back it up securely.
CREDENTIAL_ENCRYPTION_KEY=

# 配置运营方确认可用的交互服务。
NOMINATIM_PRIMARY=
NOMINATIM_BACKUP_1=
NOMINATIM_BACKUP_2=
REQUEST_INTERVAL=1500
UPSTREAM_TIMEOUT_SECONDS=10
REVERSE_TIMEOUT_SECONDS=40
REVERSE_COLD_LIMIT=16
LEGACY_HOST=nc.zaitu.cn
LEGACY_TIMEOUT_MS=6500
LOG_RETENTION_DAYS=30
STATS_TIMEZONE=Asia/Shanghai

# 每个调用方单独签发令牌。只有显式设置令牌才开放批量 API。
BATCH_LIMIT=500
BATCH_PENDING_LIMIT=2000
NOMINATIM_BATCH_URL=
NOMINATIM_BATCH_FORMAT=nominatim

# Optional server-side credential for the Altview Android batch adapter.
# Create caller ID altview-android in the OPS credentials page, then copy its
# bearer token here. Never place this value in an Android build or client file.
ALTVIEW_BATCH_BEARER_TOKEN=
